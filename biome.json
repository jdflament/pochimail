{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/pnpm-lock.yaml",
      "!**/*.md",
      "!docs",
      "!packages/ui/src/styles/tokens.json"
    ]
  },
  "css": { "parser": { "tailwindDirectives": true }, "formatter": { "enabled": false } },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": {
    "enabled": true,
    "rules": {
      "suspicious": { "noExplicitAny": "error" },
      "performance": { "noBarrelFile": "error", "noReExportAll": "error" },
      "style": { "useImportType": "error", "useNodejsImportProtocol": "error" }
    }
  },
  "overrides": [
    {
      "includes": ["packages/ui/src/styles/theme.css"],
      "linter": { "rules": { "complexity": { "noImportantStyles": "off" } } }
    },
    {
      "includes": ["packages/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "electron": "packages/core is pure TypeScript: no Electron (AGENTS.md §3)."
                },
                "patterns": [
                  {
                    "group": ["node:*"],
                    "message": "packages/core is pure TypeScript: no node:* (AGENTS.md §3)."
                  },
                  {
                    "group": ["electron/*"],
                    "message": "packages/core is pure TypeScript: no Electron (AGENTS.md §3)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
