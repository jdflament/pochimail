{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "typecheck": { "dependsOn": ["^typecheck"] },
    "lint": {},
    "test": { "dependsOn": ["^build"] },
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", "out/**"] },
    "knip": {},
    "eval": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["EVAL_DEGRADE", "EVAL_SCALE", "EVAL_TOLERANCE"]
    }
  }
}
